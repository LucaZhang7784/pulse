{
  "name": "pulse-windows",
  "version": "0.5.0",
  "description": "A floating Windows monitor for your AI coding allowances (Claude Code, Codex, OpenCode Go, DeepSeek, Kimi, Xiaomi MiMo, Antigravity, Vercel AI Gateway, MiniMax, Zhipu GLM, OfoxAI).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js && node scripts/make-ico.js",
    "providers:test": "node scripts/test-providers.js",
    "dist": "electron-builder --win"
  },
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  },
  "build": {
    "appId": "com.pulse.windows",
    "productName": "Pulse",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
